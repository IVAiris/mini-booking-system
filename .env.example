# Строка подключения к локальной PostgreSQL для разработки.
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Реальные значения хранить только в .env (не коммитить в git).
DATABASE_URL="postgresql://user:password@localhost:5432/database_name?schema=public"

# Данные единственного super_admin, создаваемого prisma/seed.ts.
# Реальные значения — только в .env, не коммитить в git.
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL="super_admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="change-me-min-8-chars"